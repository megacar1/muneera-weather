<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC1A2E"
    android:padding="16dp">

    <!-- Top: Location icon + Al Muneera • Now -->
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:text="📍" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAA" />
        <TextView android:id="@+id/location" android:text="Al Muneera • Now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAA" android:textSize="14sp" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Middle: Temp + Icon -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/temp" android:text="--°C" android:textSize="52sp" android:textStyle="bold" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/feels" android:text="Feels Like --°C" android:textSize="16sp" android:textColor="#9AA0B0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <!-- Use a system icon so it never crashes if your ic_sun is missing -->
        <ImageView android:id="@+id/big_icon" android:layout_width="72dp" android:layout_height="72dp" android:src="@android:drawable/ic_menu_day" />
    </LinearLayout>

    <!-- Bottom: Humidity + Abs -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <TextView android:id="@+id/humidity" android:text="Humidity --%" android:background="#33FFFFFF" android:padding="10dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/abs" android:text="Abs: -- g/m3" android:background="#33FFFFFF" android:padding="10dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF" android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
